generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

enum AlertType {
  DOWN
  RECOVERY
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(80)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  monitors     Monitor[]
  sessions     Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Monitor {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @map("owner_id") @db.Uuid
  name           String        @db.VarChar(80)
  url            String        @db.Text
  method         HttpMethod    @default(GET)
  intervalMinutes Int          @default(5) @map("interval_minutes")
  timeoutMs      Int           @default(10000) @map("timeout_ms")
  headers        Json          @default("{}")
  alertWebhook   String?       @map("alert_webhook") @db.Text
  active         Boolean       @default(true)
  status         MonitorStatus @default(PENDING)
  lastStatusCode Int?          @map("last_status_code")
  lastLatencyMs  Int?          @map("last_latency_ms")
  lastCheckedAt  DateTime?     @map("last_checked_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  logs           PingLog[]
  alerts         Alert[]

  @@index([ownerId, active])
  @@index([active, lastCheckedAt])
  @@map("monitors")
}

model PingLog {
  id         String        @id @default(uuid()) @db.Uuid
  monitorId  String        @map("monitor_id") @db.Uuid
  status     MonitorStatus
  statusCode Int?          @map("status_code")
  latencyMs  Int           @map("latency_ms")
  error      String?       @db.Text
  checkedAt  DateTime      @default(now()) @map("checked_at")
  monitor    Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("ping_logs")
}

model Alert {
  id        String    @id @default(uuid()) @db.Uuid
  monitorId String    @map("monitor_id") @db.Uuid
  type      AlertType
  message   String    @db.Text
  delivered Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  monitor   Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt(sort: Desc)])
  @@map("alerts")
}
